# Build context is the repo root (docker/docker-compose.yml uses context: ..).
# Keep Python bytecode, test caches, VCS, and scratch out of the image layers.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/*.egg-info/
.git/
.gitignore
.superpowers/
.worktrees/
node_modules/
*.log
# Docs/wiki/plugins are not COPYed by docker/Dockerfile (it copies gateway/ only);
# excluding them keeps the context small and builds fast.
wiki/
apple_proposal/
