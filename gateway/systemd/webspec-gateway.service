# Single-user DEVELOPMENT setup: a systemd --user unit that runs the gateway as your own
# login user, with its key file, config and log in your home directory. It does not meet
# DP-1 or DP-4 (docs/spec/audit-deployment.md): an agent running as the same user can read
# ~/.webspec/gateway.env (the guard key) and rewrite the gateway's configuration.
# For production, use the hardened system unit and its installer in gateway/deploy/linux/
# (sudo gateway/deploy/linux/install.sh). Stop this unit first: they share port 7002.

[Unit]
Description=WebSpec Local Gateway — REST interface to MCP servers
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m webspec
WorkingDirectory=%h/MCP/webspec-gateway
Environment=PYTHONPATH=%h/MCP/webspec-gateway
Environment=WEBSPEC_PORT=7001
Environment=WEBSPEC_INTERNAL_PORT=7002
# Guard key must be sourced from your password manager into this file, e.g.:
#   echo "WEBSPEC_GUARD_KEY=$(op read 'op://WebSpec/gateway-guard/key')" > ~/.webspec/gateway.env
# Without WEBSPEC_GUARD_KEY the gateway fails closed (guarded services return errors).
EnvironmentFile=-%h/.webspec/gateway.env
Restart=always
RestartSec=3

StandardOutput=append:%h/.webspec/gateway.log
StandardError=append:%h/.webspec/gateway.log

[Install]
WantedBy=default.target
